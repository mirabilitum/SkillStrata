# SkillStrata 配置文件样例
# 复制为 .env 后按需修改，零配置也能默认跑
# 解析链：CLI flag > 环境变量 > .env 文件 > 内置默认值

# 数据目录（默认 .distiller-data，已 gitignore）
data_dir=.distiller-data

# daemon 批处理大小
batch_size=16

# 复用频率阈值：同一工具被≥N次复用后统计晋升
reuse_frequency_n=3

# Judge 模型档位（haiku | sonnet），仅目的判同/命名/归类用
judge_tier=haiku

# Judge 疑难升档（默认 sonnet），ambiguous 候选触发
judge_escalate_tier=sonnet

# API Key（可选，不配则退化为 offline 规则引擎，不阻塞主链）
# 也支持环境变量 ANTHROPIC_API_KEY
# api_key=sk-ant-...
